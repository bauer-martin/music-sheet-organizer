    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "preview": "vite preview",
    "i18n:extract": "i18next-cli extract",
